        private readonly Dictionary<MAVLinkInterface, GMapRoute> vehicleRoutes = new Dictionary<MAVLinkInterface, GMapRoute>();

        Color[] colors4trail ={
            Color.FromArgb(128,255,128), // green path
            Color.FromArgb(255,153,255),//violet path
            Color.FromArgb(204, 204, 0),//yellow path
            Color.FromArgb(153, 153, 255),//blue path
            Color.FromArgb(255, 210, 128),//orange path
            Color.FromArgb(255, 153, 153) };//red path
        private GMapRoute GetRoute(MAVLinkInterface port)
        {
            if (!vehicleRoutes.TryGetValue(port, out var route))
            {
                route = new GMapRoute(new List<PointLatLng>(), "track_" + port.ToString());

                int index = (port.MAV.sysid - 1) % colors4trail.Length;  // set the color same as boat color
                route.Stroke = new Pen(colors4trail[index], 2);
                //route.Stroke = new Pen(Color.Blue, 2);                          
                vehicleRoutes[port] = route;
                routes.Routes.Add(route);
            }

            return route;
        }
