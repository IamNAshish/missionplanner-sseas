                "Camera — show or hide mini video on the map (bottom-right). Right-click the video for stream and gimbal options.");

            // 07june26_task1
            _picjoystick = new PictureBox 
            {
                Name = "picjoystick",
                Size = new Size(36, 36),
                SizeMode = PictureBoxSizeMode.Zoom,
                Cursor = Cursors.Hand,
                TabStop = false,
