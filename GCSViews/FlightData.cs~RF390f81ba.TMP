                                this.G_fuel.DataBindings.Add(new System.Windows.Forms.Binding("Value1", this.bindingSourceGaugesTab, "customfield" + mav_G_fuel_custom_number, true));//bindingSourceGaugesTab
                            }
                            else if (name == "MAV_WT")//water flow temp
